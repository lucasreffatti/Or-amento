generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  document       String?
  address        String?
  
  // Campos Fiscais da Oficina / Empresa
  ie             String?  // Inscrição Estadual
  im             String?  // Inscrição Municipal
  taxRegime      String   @default("SIMPLES_NACIONAL") // SIMPLES_NACIONAL, REGIME_NORMAL, MEI
  cnae           String?  @default("4520-0/01") // Manutenção e reparação de veículos automotores
  cityIbge       String?  @default("4211900") // Palhoça/SC
  nfeEnvironment String   @default("HOMOLOGATION") // HOMOLOGATION, PRODUCTION
  nfeApiToken    String?  // Token de autenticação da API Fiscal (Focus NFe, PlugNotas, e-Notas, etc.)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users        User[]
  customers    Customer[]
  vehicles     Vehicle[]
  checklists   Checklist[]
  budgets      Budget[]
  stockItems   StockItem[]
  invoices     Invoice[]
  suppliers    Supplier[]
  stockEntries StockEntry[]
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String?  // Made optional since we use username for login
  username  String   @unique @default("sergiocar")
  name      String?
  password  String   @default("") // Will hold bcrypt hash
  role      String   @default("ADMIN") // ADMIN, USER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  phone       String   
  email       String?
  document    String?  // CPF ou CNPJ
  
  // Campos Fiscais do Cliente
  personType   String   @default("INDIVIDUAL") // INDIVIDUAL (PF), LEGAL_ENTITY (PJ)
  ie           String?  // Inscrição Estadual (se Pessoa Jurídica contribuinte)
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  cep          String?
  cityIbge     String?
  
  createdAt   DateTime @default(now())
  
  vehicles   Vehicle[]
  budgets    Budget[]
  checklists Checklist[]
  invoices   Invoice[]
}

model Vehicle {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  plate      String   @unique 
  brand      String      
  model      String
  year       Int
  engineType String   // GASOLINE, DIESEL, FLEX, HYBRID
  mileage    Int?
  notes      String?
  
  checklists Checklist[]
  budgets    Budget[]
}

model Checklist {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  
  fuelLevel     Int      
  reportedIssue String   
  obd2Codes     String?  
  
  itemsStatus   String   // JSON convertido para String
  imagesUrls    String   @default("[]") // Lista convertida para String JSON
  additionalInfo String?
  
  status        String   @default("PENDENTE") // PENDENTE, APROVADO, RECUSADO
  
  customerSignature String? 
  budget        Budget?
  createdAt     DateTime @default(now())
}

model Budget {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  
  status        String   @default("DRAFT") // DRAFT, SENT, PARTIALLY_APPROVED, APPROVED, REJECTED
  serviceType   String   @default("INTERNAL") // INTERNAL, EXTERNAL
  validUntil    DateTime
  totalLabor    Float    @default(0)
  totalParts    Float    @default(0)
  discount      Float    @default(0)
  finalTotal    Float    @default(0)
  
  externalLink  String?  @unique 
  checklistId   String?  @unique
  checklist     Checklist? @relation(fields: [checklistId], references: [id])

  items         BudgetItem[]
  invoice       Invoice?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BudgetItem {
  id          String     @id @default(cuid())
  budgetId    String
  budget      Budget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  
  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id])

  type        String     // "PART" ou "LABOR"
  description String   
  quantity    Int        @default(1)
  unitCost    Float    
  unitPrice   Float    
  approved    Boolean    @default(true) 
}

model Supplier {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String   // Razão Social
  tradeName    String?  // Nome Fantasia
  document     String   // CNPJ
  ie           String?  // Inscrição Estadual
  phone        String?
  email        String?
  address      String?
  city         String?
  state        String?
  cep          String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockEntries StockEntry[]
  stockItems   StockItem[]

  @@unique([tenantId, document])
}

model StockItem {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  code        String   // SKU / Código de Barras / Referência
  description String
  itemType    String   @default("FIXO") // FIXO (Prateleira / Permanente) ou ROTATIVO (Encomenda / Direta)
  ncm         String?  @default("8708.29.99") // NCM para autopeças
  cest        String?  // Código Especificador da Substituição Tributária
  unit        String   @default("UN") // UN, PÇ, LT, KG, CX, JG
  costPrice   Float    @default(0)
  salePrice   Float    @default(0)
  quantity    Int      @default(0)
  minQuantity Int      @default(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budgetItems BudgetItem[]
  entryItems  StockEntryItem[]

  @@unique([tenantId, code])
}

model StockEntry {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  supplierId   String
  supplier     Supplier         @relation(fields: [supplierId], references: [id])
  
  nfeKey       String           // Chave de 44 dígitos da nota do fornecedor
  nfeNumber    String           // Número da Nota Fiscal
  nfeSeries    String?          @default("1")
  issueDate    DateTime?
  totalAmount  Float            @default(0)
  
  items        StockEntryItem[]

  createdAt    DateTime         @default(now())

  @@unique([tenantId, nfeKey])
}

model StockEntryItem {
  id                  String     @id @default(cuid())
  stockEntryId        String
  stockEntry          StockEntry @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  stockItemId         String?
  stockItem           StockItem? @relation(fields: [stockItemId], references: [id])

  supplierProductCode String     // Código cProd da Distribuidora
  description         String     // Descrição no XML
  ncm                 String?
  unit                String     @default("UN")
  quantity            Int        @default(1)
  costUnitPrice       Float      @default(0)
  totalPrice          Float      @default(0)
}

model Invoice {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  budgetId     String?       @unique
  budget       Budget?       @relation(fields: [budgetId], references: [id])
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])

  type         String        @default("NFE_PARTS") // NFSE_SERVICE, NFE_PARTS, COMBINED
  status       String        @default("DRAFT") // DRAFT, PENDING, AUTHORIZED, CANCELLED, ERROR
  number       Int?
  series       Int?          @default(1)
  accessKey    String?       // Chave de Acesso de 44 dígitos
  protocol     String?       // Protocolo de autorização
  xmlUrl       String?
  pdfUrl       String?
  errorMessage String?

  laborTotal   Float         @default(0)
  partsTotal   Float         @default(0)
  taxTotal     Float         @default(0)
  finalTotal   Float         @default(0)

  items        InvoiceItem[]

  issuedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  type        String   // SERVICE ou PART
  description String
  ncm         String?  // NCM da peça
  serviceCode String?  // Código do Serviço municipal (NFS-e)
  unit        String   @default("UN")
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
}
